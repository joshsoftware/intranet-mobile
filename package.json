{
  "name": "Intranet",
  "version": "2.8.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --mode=devDebug --appId=com.joshsoftware.intranet.dev",
    "android-dev-release": "react-native run-android --mode=devRelease --appId=com.joshsoftware.intranet.dev",
    "android-stage-debug": "react-native run-android --mode=stageDebug --appId=com.joshsoftware.intranet.stage",
    "android-stage-release": "react-native run-android --mode=stageRelease --appId=com.joshsoftware.intranet.stage",
    "android-prod-debug": "react-native run-android --mode=prodDebug --appId=com.joshsoftware.intranet",
    "android-prod-release": "react-native run-android --mode=prodRelease --appId=com.joshsoftware.intranet",
    "ios": "react-native run-ios --scheme Intranet",
    "ios-prod": "ENVFILE=.env.prod react-native run-ios --scheme Intranet",
    "ios-stage": "ENVFILE=.env.stage react-native run-ios --scheme Intranet-Stage --mode Debug",
    "ios-stage-release": "ENVFILE=.env.stage react-native run-ios --scheme Intranet-Stage --mode Release",
    "lint": "eslint .",
    "start": "react-native start",
    "updateversion": "react-native-version --never-amend",
    "test": "jest",
    "postinstall": "node ./scripts/patch-tab-view.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.1.1",
    "@invertase/react-native-apple-authentication": "^2.2.2",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@notifee/react-native": "^7.8.2",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-community/checkbox": "^0.5.20",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-firebase/app": "^21.6.1",
    "@react-native-firebase/crashlytics": "^21.6.1",
    "@react-native-firebase/messaging": "^21.6.1",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-picker/picker": "^2.4.10",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/drawer": "^6.6.3",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/native-stack": "^6.9.13",
    "@react-navigation/stack": "^6.4.1",
    "@tanstack/react-query": "^5.100.10",
    "axios": "^1.4.0",
    "moment": "^2.29.4",
    "react": "19.2.3",
    "react-hook-form": "^7.45.2",
    "react-native": "0.85.1",
    "react-native-animatable": "^1.4.0",
    "react-native-bootsplash": "^6.2.1",
    "react-native-calendars": "^1.1300.0",
    "react-native-check-version": "^1.4.0",
    "react-native-circular-progress-indicator": "^4.4.2",
    "react-native-collapsible": "^1.6.2",
    "react-native-config": "^1.6.1",
    "react-native-date-picker": "^5.0.0",
    "react-native-device-info": "^14.0.0",
    "react-native-element-dropdown": "^2.12.1",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-modal": "^13.0.1",
    "react-native-pager-view": "^6.6.0",
    "react-native-permissions": "^5.6.1",
    "react-native-picker-select": "^8.0.4",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "^5.1.0",
    "react-native-screens": "4.25.0",
    "react-native-svg": "^15.10.1",
    "react-native-svg-transformer": "^1.1.0",
    "react-native-tab-view": "^4.0.5",
    "react-native-toast-message": "^2.2.1",
    "react-native-worklets": "^0.10.0",
    "yup": "^1.2.0"
