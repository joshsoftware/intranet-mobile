{
  "name": "Intranet",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android --variant=devdebug --appIdSuffix=dev",
    "android-dev-release": "react-native run-android --variant=devrelease --appIdSuffix=dev",
    "android-stage-debug": "react-native run-android --variant=stagedebug --appIdSuffix=stage",
    "android-stage-release": "react-native run-android --variant=stagerelease --appIdSuffix=stage",
    "android-prod-debug": "react-native run-android --variant=proddebug",
    "android-prod-release": "react-native run-android --variant=prodrelease",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "updateversion": "react-native-version --never-amend",
    "test": "jest",
    "clean": "./android/gradlew -p android clean",
    "bundle:prod": "./android/gradlew -p android bundleProdRelease",
    "assemble:prod": "./android/gradlew -p android assembleProdRelease",
    "build:prod": "npm run bundle:prod && npm run assemble:prod"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.1.1",
    "@invertase/react-native-apple-authentication": "^2.2.2",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/checkbox": "^0.5.16",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-native-firebase/app": "^21.6.1",
    "@react-native-firebase/crashlytics": "^21.6.1",
    "@react-native-firebase/messaging": "^21.6.1",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-native-picker/picker": "^2.4.10",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/drawer": "^6.6.3",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/native-stack": "^6.9.13",
    "axios": "^1.4.0",
    "moment": "^2.29.4",
    "react": "18.3.1",
    "react-hook-form": "^7.45.2",
    "react-native": "0.77.3",
    "react-native-animatable": "^1.3.3",
    "react-native-bootsplash": "^6.2.1",
    "react-native-calendars": "^1.1300.0",
    "react-native-check-version": "^1.1.1",
    "react-native-circular-progress-indicator": "^4.4.2",
    "react-native-collapsible": "^1.6.1",
    "react-native-config": "^1.5.3",
    "react-native-date-picker": "^5.0.0",
    "react-native-device-info": "^14.0.0",
    "react-native-gesture-handler": "2.23.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-modal": "^13.0.1",
    "react-native-pager-view": "^6.6.0",
    "react-native-picker-select": "^8.0.4",
    "react-native-reanimated": "3.17.1",
    "react-native-safe-area-context": "^5.1.0",
    "react-native-screens": "4.7.0",
    "react-native-svg": "^15.10.1",
    "react-native-svg-transformer": "^1.1.0",
    "react-native-tab-view": "^4.0.5",
    "react-native-toast-message": "^2.2.1",
    "react-query": "^3.39.3",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "^0.77.3",
    "@react-native/eslint-config": "^0.77.3",
    "@react-native/metro-config": "^0.77.3",
    "@react-native/typescript-config": "0.77.3",
    "@types/jest": "^29.5.13",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "^2.8.8",
    "react-native-version": "^4.0.0",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "react-native-picker-select": {
      "@react-native-picker/picker": "$@react-native-picker/picker"
    }
  }
}